# PKG Traders Web Platform Environment Configuration Template
# DO NOT COMMIT ACTUAL PASSWORDS OR SECRET KEYS TO SOURCE CONTROL

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
DATABASE_URL="postgresql://pkg_user:secure_password@localhost:5432/pkgtraders_db?schema=public"

# ---------------------------------------------------------
# JWT AUTHENTICATION SECRETS
# ---------------------------------------------------------
JWT_CLIENT_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_CLIENT_SECRET_32BYTES_MIN"
JWT_ADMIN_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_ADMIN_SECRET_32BYTES_MIN"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------
# BOT <-> BACKEND HMAC SERVICE AUTHENTICATION
# ---------------------------------------------------------
BOT_HMAC_SECRET="CHANGE_ME_IN_PRODUCTION_BOT_HMAC_KEY_64BYTES_MIN"
BOT_API_KEY="pkg_bot_live_api_key_v1"

# ---------------------------------------------------------
# SERVER & CORS CONFIGURATION
# ---------------------------------------------------------
PORT=4000
NODE_ENV="development"
CLIENT_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
BACKEND_API_URL="http://localhost:4000"

# ---------------------------------------------------------
# SECURITY & RATE LIMITING
# ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
