# ================================================================
# XAUUSD Pro Scalper — Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it contains secrets
# ================================================================

# ── MetaTrader 5 ─────────────────────────────────────────────────
MT5_LOGIN=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER_NAME
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MAGIC_NUMBER=20250701

# ── Symbol override (leave blank for auto-discovery) ─────────────
SYMBOL=XAUUSD
TIMEFRAME=M15

# ── Telegram (optional — bot operates without notifications) ──────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── News APIs (all optional — bot operates without them) ─────────
NEWS_API_KEY=
MARKETAUX_API_KEY=
TRADING_ECONOMICS_KEY=

# ── Risk Management ───────────────────────────────────────────────
INITIAL_BALANCE=500
RISK_PER_TRADE_PCT=1.0
COMPOUNDING_ENABLED=true
DAILY_DD_LIMIT_PCT=3.0
WEEKLY_DD_LIMIT_PCT=6.0
ACCOUNT_DD_LIMIT_PCT=10.0
MAX_OPEN_TRADES=3
MAX_RISK_EXPOSURE_PCT=3.0
MIN_QUALITY_SCORE=85

# ── Dashboard ────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_API_KEY=change_me_to_a_strong_secret

# ── ML Layer ─────────────────────────────────────────────────────
ML_ENABLED=true
ML_MIN_SAMPLES=50

# ── System ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
DB_PATH=database/trading.db
ENVIRONMENT=production

# ── Trade Quality Scoring ─────────────────────────────────────────
USE_RECALIBRATED_SCORING=true
SHADOW_MODE=false
